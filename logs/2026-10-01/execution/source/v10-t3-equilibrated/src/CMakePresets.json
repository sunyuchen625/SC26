{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "SolverChallenge26 default",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SC26_BUILD_MPI": "ON",
        "SC26_ENABLE_FLOAT128": "ON",
        "SC26_PROBLEM": "01"
      }
    },
    {
      "name": "serial",
      "displayName": "SolverChallenge26 serial",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-serial",
      "cacheVariables": {
        "SC26_BUILD_MPI": "OFF"
      }
    }
  ]
}
